[Desktop Entry]
Type=Application
Name=VisionPDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=visionpdf %U
TryExec=visionpdf
Icon=com.futurevision.visionpdf
Terminal=false
StartupNotify=true
